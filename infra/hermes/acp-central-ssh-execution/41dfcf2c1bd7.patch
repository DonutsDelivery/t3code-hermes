+        register_task_env_overrides(task_id, {"cwd": _translate_acp_cwd(_resolve_tool_cwd(cwd))})
     except Exception:
         logger.debug("Failed to register ACP task cwd override", exc_info=True)
 
 
+def _resolve_tool_cwd(cwd: str) -> str:
+    """Tools on an SSH backend run in the configured remote ``TERMINAL_CWD``: the client's cwd is a
+    path on the Hermes host, which need not exist on the target."""
+    if (os.getenv("TERMINAL_ENV") or "local").strip().lower() == "ssh":
+        remote_cwd = (os.getenv("TERMINAL_CWD") or "").strip()
+        if remote_cwd:
+            return remote_cwd
+    return cwd
+
