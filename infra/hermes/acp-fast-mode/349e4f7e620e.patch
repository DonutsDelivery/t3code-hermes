@@ -0,0 +1,198 @@
+"""Session-scoped fast mode over ACP, and the per-endpoint opt-in that lets a proxy receive it.
+
+Real config-file → ``load_config`` → fast-mode gate chain on the per-test ``HERMES_HOME``. ``hermes
+acp`` is a gateway viewer, so the session tests drive ``GatewayACPAgent`` against a real owner
+``AuthorityConnection`` and the owner's own per-turn route (``_resolve_turn_agent_config``); only the
+model inventory and the turn's model call are stubbed.
+"""
+
+import asyncio
+import os
+from pathlib import Path
+from types import MethodType, SimpleNamespace
+from unittest.mock import patch
+
+import acp
+import hermes_yaml as yaml
+import pytest
+import pytest_asyncio
+from acp.schema import ModelInfo, SessionModelState
+
+from acp_adapter.gateway_server import GatewayACPAgent
+from acp_adapter.model_catalog import mark_fast_mode_models
+from hermes_cli.gateway_client import GatewayClientError, GatewayRPCError
+from hermes_cli.models import resolve_fast_mode_overrides
+
+PROXY = "http://proxy.test:8317/v1"
+
+
+@pytest.fixture
+def hermes_config(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+
+    def write(custom_providers: list[dict]) -> None:
+        (Path(os.environ["HERMES_HOME"]) / "config.yaml").write_text(
+            yaml.safe_dump({"custom_providers": custom_providers}), encoding="utf-8")
+
+    write([
+        {"name": "proxy", "base_url": PROXY, "capabilities": {"fast_mode": True}},
+        {"name": "plain", "base_url": "http://plain.test/v1"},
+    ])
+    return write
+
+
+def test_opted_in_endpoint_receives_service_tier_only(hermes_config):
+    assert resolve_fast_mode_overrides("gpt-5.5", provider="custom", base_url=PROXY + "/") == {
+        "service_tier": "priority"}
+    # Anthropic's ``speed`` is a Messages API parameter; a chat-completions proxy never gets it.
+    assert resolve_fast_mode_overrides("claude-opus-5-5", provider="custom", base_url=PROXY) is None
+    # Without the capability a proxy stays gated, as before.
+    assert resolve_fast_mode_overrides("gpt-5.5", provider="custom", base_url="http://plain.test/v1") is None
+
+
+def test_model_rows_carry_fast_mode_meta_where_the_route_takes_it(hermes_config):
+    ids = ["custom:proxy:gpt-5.5", "custom:proxy:claude-opus-5-5", "custom:proxy:glm-5.1",
+           "custom:plain:gpt-5.5", "openai-codex:gpt-5.5", "openrouter:openai/gpt-5.5"]
+    state = SessionModelState(available_models=[ModelInfo(model_id=i, name=i) for i in ids],
+                              current_model_id=ids[0])
+
+    marked = mark_fast_mode_models(state)
+
+    fast = [m.model_id for m in marked.available_models if (m.field_meta or {}).get("hermes", {}).get("fastMode")]
+    assert fast == ["custom:proxy:gpt-5.5", "openai-codex:gpt-5.5"]
+    assert marked.current_model_id == ids[0]
+
+
+def test_session_picker_marks_fast_rows(hermes_config):
+    """The picker every new/load/resume/fork reply carries (``_session_fields``) has the tags."""
+    from acp_adapter.gateway_session_meta import model_state
+
+    picker = SessionModelState(available_models=[ModelInfo(model_id="custom:proxy:gpt-5.5", name="gpt-5.5"),
+                                                 ModelInfo(model_id="custom:plain:gpt-5.5", name="gpt-5.5")],
+                               current_model_id="custom:proxy:gpt-5.5")
+    with patch("acp_adapter.model_catalog.build_model_state", return_value=picker):
+        state = model_state({"model": "gpt-5.5", "provider": "custom:proxy"})
+
+    assert [m.field_meta for m in state.available_models] == [{"hermes": {"fastMode": True}}, None]
+    assert state.current_model_id == "custom:proxy:gpt-5.5"
+
+
+class Wire:
+    """The ACP agent's gateway client over a real owner ``AuthorityConnection``."""
+
+    def __init__(self, loop):
+        self.loop, self.events, self.serial, self.viewer, self.calls = loop, asyncio.Queue(), 0, None, []
+
+    def write(self, frame):  # the authority's transport (may be called off-loop)
+        self.loop.call_soon_threadsafe(self.events.put_nowait, frame)
+        return True
+
+    async def rpc(self, method, *, _timeout=None, **params):
+        self.serial += 1
+        self.calls.append((method, params))
+        reply = await self.viewer.dispatch({'id': self.serial, 'method': method, 'params': params})
+        if 'error' in reply:
+            raise GatewayRPCError(reply['error'].get('data', {}).get('reason', 'request_failed'))
+        return reply['result']
+
+
+@pytest_asyncio.fixture
+async def gateway(hermes_config, tmp_path, monkeypatch):
+    """An editor attached to session ``s`` on a real owner; ``tiers`` records each turn's tier."""
+    from gateway.run import GatewayRunner
+    from gateway.session_controls import AuthorityConnection
+    from gateway.session_state import SERVICE_TIER_UNSET
+    from tests.gateway.test_surface_admission import _authority
+
+    tiers = []
+
+    async def answer(event):
+        from gateway.session_results import execution_result
+        tiers.append(authority.runner._resolve_session_service_tier(session_key=route))
+        execution_result.get()['result'] = {'final_response': 'ok', 'completed': True, 'messages': []}
+        return 'ok'
+
+    authority = await _authority(tmp_path, monkeypatch, answer)
+    # The fixture runner is a bare namespace: give it the real runner's per-session tier methods.
+    for name in ('_sessions_map', '_session_state', '_peek_session_state', '_set_session_service_tier_override',
+                 '_resolve_session_service_tier'):
+        setattr(authority.runner, name, MethodType(getattr(GatewayRunner, name), authority.runner))
+    authority.runner._load_service_tier = GatewayRunner._load_service_tier  # classmethod: already bound
+    authority.runner._resolve_session_key_or_none = lambda source, session_key: session_key
+    route = authority.sessions['s'].route
+    wire = Wire(asyncio.get_running_loop())
+    wire.viewer = AuthorityConnection(authority, wire, {'user_id': 'editor'})
+    agent = GatewayACPAgent()
+    agent._gateway = wire
+    agent._conn = SimpleNamespace(session_update=lambda **kwargs: asyncio.sleep(0))
+    agent._snapshots['s'] = await wire.rpc('session.resume', session_id='s')
+    agent._event_task = asyncio.create_task(agent._events())
+
+    def override():
+        state = authority.runner._peek_session_state(route)
+        return SERVICE_TIER_UNSET if state is None else state.conversation.service_tier_override
+
+    try:
+        yield SimpleNamespace(agent=agent, wire=wire, runner=authority.runner, route=route, override=override,
+                              tiers=tiers, unset=SERVICE_TIER_UNSET)
+    finally:
+        agent._event_task.cancel()
+        await wire.viewer.close()
+        authority.runner.session_store.close_all_db_handles()
+
+
+def _turn_overrides(runner, route, base_url):
+    """The request overrides the owner's next turn sends on ``base_url`` (``_resolve_turn_agent_config``)."""
+    from gateway.run import GatewayRunner
+
+    turn = SimpleNamespace(_service_tier=runner._resolve_session_service_tier(session_key=route))
+    runtime = {"provider": "custom", "base_url": base_url, "api_mode": "chat_completions", "args": [],
+               "request_overrides": {"extra_body": {"tags": ["t3"]}}}
+    return GatewayRunner._resolve_turn_agent_config(turn, "hi", "gpt-5.5", runtime)["request_overrides"]
+
+
+@pytest.mark.asyncio
+async def test_fast_mode_option_pins_the_owner_sessions_tier(gateway):
+    await gateway.agent.set_config_option("fast_mode", "s", "on")
+
+    assert gateway.override() == "priority"
+    assert _turn_overrides(gateway.runner, gateway.route, PROXY) == {
+        "extra_body": {"tags": ["t3"]}, "service_tier": "priority"}
+
+    # Off is an explicit normal pin, not "follow the profile": a profile-wide fast tier must not win.
+    await gateway.agent.set_config_option("fast_mode", "s", "off")
+    assert gateway.override() is None
+    assert _turn_overrides(gateway.runner, gateway.route, PROXY) == {"extra_body": {"tags": ["t3"]}}
+
+
+@pytest.mark.asyncio
+async def test_fast_mode_on_an_unsupported_route_sends_nothing(gateway):
+    await gateway.agent.set_config_option("fast_mode", "s", "on")
+
+    assert _turn_overrides(gateway.runner, gateway.route, "http://plain.test/v1") == {
+        "extra_body": {"tags": ["t3"]}}
+
+
+@pytest.mark.asyncio
+async def test_every_prompt_re_pins_the_tier_the_owner_dropped(gateway):
+    # An untouched session keeps the owner's own default and sends no tier write.
+    await asyncio.wait_for(gateway.agent.prompt([acp.text_block("untouched")], "s"), 5)
+    assert gateway.tiers == [None]
+    assert not [p for m, p in gateway.wire.calls if m == "config.set"]
+
+    await gateway.agent.set_config_option("fast_mode", "s", "on")
+    # The owner keeps the pin in memory: a gateway restart or a conversation boundary drops it.
+    gateway.runner._set_session_service_tier_override(gateway.route, None, clear=True)
+    assert gateway.override() is gateway.unset
+
+    response = await asyncio.wait_for(gateway.agent.prompt([acp.text_block("go fast")], "s"), 5)
+
+    assert response.stop_reason == "end_turn"
+    assert gateway.tiers == [None, "priority"]
+
+
+@pytest.mark.asyncio
+async def test_fast_mode_on_a_session_the_editor_does_not_hold_is_refused(gateway):
+    with pytest.raises(GatewayClientError, match="not_found"):
+        await gateway.agent.set_config_option("fast_mode", "other", "on")
+    assert gateway.override() is gateway.unset
